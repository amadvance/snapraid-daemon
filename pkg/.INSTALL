post_install() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        systemctl enable snapraidd.service >/dev/null || true
        systemctl start snapraidd.service >/dev/null || true
    fi
}

post_upgrade() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        systemctl try-restart snapraidd.service 'snapraidd@*.service' >/dev/null || true
    fi
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl --no-reload stop snapraidd.service 'snapraidd@*.service' >/dev/null || true
        systemctl disable snapraidd.service 'snapraidd@*.service' >/dev/null || true
    fi
}

post_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
    fi
}
