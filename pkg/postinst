#!/bin/sh
set -e

# Reload systemd, enable and start the service
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
    if [ -z "$2" ]; then
        # Fresh install: enable and start the default service
        systemctl enable snapraidd.service >/dev/null || true
        systemctl start snapraidd.service >/dev/null || true
    else
        # Upgrade: preserve enablement state and restart running services
        systemctl try-restart snapraidd.service 'snapraidd@*.service' >/dev/null || true
    fi
fi

exit 0
