# -------------------------------------------------------------------------
# SnapRAID Daemon Installer Script
# -------------------------------------------------------------------------

# --- Header Includes ---
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "StrFunc.nsh"

${StrStr}
${UnStrStr}

# --- General Project Settings ---
Name "SnapRAID Daemon"
OutFile "snapraid-daemon-@PACKAGE_VERSION@.exe"
InstallDir "DEFAULT"
InstallDirRegKey HKLM "Software\snapraid" "Install_Dir"
RequestExecutionLevel admin

# --- Visual Assets ---
# These files must exist in your Slackware build directory
Icon "snapraid-daemon.ico"
UninstallIcon "snapraid-daemon.ico"

# --- Version Information ---
# Product version must be in X.X.X.X format
VIProductVersion "1.0.0.0"
VIAddVersionKey "ProductName" "SnapRAID Daemon"
VIAddVersionKey "FileDescription" "SnapRAID Daemon"
VIAddVersionKey "LegalCopyright" "© 2026 Andrea Mazzoleni"
VIAddVersionKey "FileVersion" "@PACKAGE_VERSION@"
VIAddVersionKey "ProductVersion" "@PACKAGE_VERSION@"

# --- MUI Settings ---
!define MUI_ABORTWARNING
!define MUI_ICON "snapraid-daemon.ico"
!define MUI_UNICON "snapraid-daemon.ico"

# Installer Pages
!define MUI_PAGE_HEADER_TEXT "Choose Installation Location"
!define MUI_PAGE_HEADER_SUBTEXT "Select the folder for SnapRAID and the Daemon."
!define MUI_DIRECTORYPAGE_TEXT_TOP "IMPORTANT: If you already have SnapRAID installed, please select the SAME directory to ensure it is updated correctly. $\r$\n$\r$\nOtherwise, the installer will create a new installation of both SnapRAID and the Daemon in the folder below."
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES

# Finish Page
!define MUI_FINISHPAGE_LINK "Open SnapRAID Web Interface now"
!define MUI_FINISHPAGE_LINK_LOCATION "http://localhost:7627/"
!insertmacro MUI_PAGE_FINISH

# Uninstaller Pages
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

# Languages
!insertmacro MUI_LANGUAGE "English"

# --- Functions ---

Function .onInit
    ${If} $INSTDIR == "DEFAULT"
    ${OrIf} $INSTDIR == ""
        StrCpy $1 $WINDIR 2
        StrCpy $INSTDIR "$1\snapraid"
    ${EndIf}
FunctionEnd

# Define the registry path for the Event Log
!define LOG_REG "SYSTEM\CurrentControlSet\Services\EventLog\Application\snapraidd"

# --- Installation Section ---

Section "Install"
    # STOP ALL INSTANCES (default + user-created)
    ClearErrors
    ExecWait '"$INSTDIR\snapraidd.exe" --service-stop-all' $0
    ${If} ${Errors}
    ${OrIf} $0 != 0
        # taskkill kills every process using snapraidd.exe, unlocking the binary
        DetailPrint "Stop timed out. Forcing taskkill..."
        ExecWait 'taskkill /F /IM snapraidd.exe'
        Sleep 1000
    ${EndIf}

    # FILES
    SetOutPath $INSTDIR
    File "snapraid*.exe"
    File "smartctl.exe"
    File "commander.zip"
    File "brutale.zip"
    File "snapraid*.example"
    File "authors.txt"
    File "copying.txt"
    File "history.txt"
    File "readme.txt"

    # DOCUMENTATION
    SetOutPath $INSTDIR\doc
    File "snapraid*.txt"

    # DELETE OLD DOCUMENTATION
    Delete "$INSTDIR\snapraid.txt"
    Delete "$INSTDIR\install.txt"
    Delete "$INSTDIR\todo.txt"

    # CONFIGURATION & SERVICE REGISTRATION
    SetOutPath $INSTDIR
    # Check if snapraidd.conf already exists on the Windows machine
    IfFileExists "$INSTDIR\snapraidd.conf" SkipConfig
        DetailPrint "No configuration found. Installing default..."
        File "/oname=$INSTDIR\snapraidd.conf" "snapraidd.conf.example"
        Goto ConfigDone
    SkipConfig:
        DetailPrint "Existing configuration detected. Skipping overwrite."
    ConfigDone:

    # Determine if ANY snapraidd service is registered
    StrCpy $0 0
    StrCpy $3 0 # 0 = none found, 1 = found at least one
    LoopCheckServices:
        EnumRegKey $1 HKLM "SYSTEM\CurrentControlSet\Services" $0
        StrCmp $1 "" DoneCheckServices
        
        # Check if service name starts with "snapraidd"
        StrCpy $2 $1 9
        StrCmp $2 "snapraidd" 0 NextCheckService
        
        # Check if it is an exact match or followed by "-" (e.g. snapraidd-instance)
        StrCpy $2 $1 1 9
        StrCmp $2 "" FoundOurService
        StrCmp $2 "-" FoundOurService
        Goto NextCheckService
        
    FoundOurService:
        # Found at least one service!
        StrCpy $3 1
        Goto DoneCheckServices
        
    NextCheckService:
        IntOp $0 $0 + 1
        Goto LoopCheckServices
    DoneCheckServices:

    ${If} $3 == 0
        # No service is registered: install the default service
        ExecWait '"$INSTDIR\snapraidd.exe" --service-install'
    ${EndIf}

    # RESTART ALL INSTANCES (default + user-created)
    ExecWait '"$INSTDIR\snapraidd.exe" --service-start-all'

    # Save the installation directory to the registry
    WriteRegStr HKLM "Software\snapraid" "Install_Dir" "$INSTDIR"

    # CREATE DESKTOP SHORTCUT
    CreateShortcut "$DESKTOP\SnapRAID Commander.lnk" "http://localhost:7627/" "" "$INSTDIR\snapraid-uninstall.exe" 0

    # WRITE THE UNINSTALL KEYS FOR WINDOWS CONTROL PANEL
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "DisplayName" "SnapRAID Daemon"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "UninstallString" '"$INSTDIR\snapraid-uninstall.exe"'
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "DisplayIcon" "$INSTDIR\snapraid-uninstall.exe"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "Publisher" "Andrea Mazzoleni"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd" "NoRepair" 1

    # FIREWALL
    DetailPrint "Adding Firewall exception for SnapRAID Daemon..."
    nsExec::Exec 'netsh advfirewall firewall add rule name="SnapRAID Daemon" dir=in action=allow protocol=TCP localport=7627 profile=any enable=yes'
    Pop $1

    # WRITE UNINSTALLER
    WriteUninstaller "$INSTDIR\snapraid-uninstall.exe"
SectionEnd

# --- Uninstaller Section ---

Section "Uninstall"
    # STOP AND REMOVE ALL SERVICES
    ClearErrors
    ExecWait '"$INSTDIR\snapraidd.exe" --service-remove-all' $0
    ${If} ${Errors}
    ${OrIf} $0 != 0
        # Kill any remaining processes (safety net)
        DetailPrint "Stop timed out. Forcing taskkill..."
        ExecWait 'taskkill /F /IM snapraidd.exe'
        Sleep 1000
	# Clean up the Event Source registry keys
	DeleteRegKey HKLM "${LOG_REG}"
    ${EndIf}

    # FIREWALL
    DetailPrint "Removing Firewall exception..."
    nsExec::Exec 'netsh advfirewall firewall delete rule name="SnapRAID Daemon"'
    Pop $1

    # DELETE KEYS
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\snapraidd"

    # REMOVE SHORTCUT
    Delete "$DESKTOP\SnapRAID Commander.lnk"

    # REMOVE FILES
    Delete "$INSTDIR\snapraid-uninstall.exe"
    Delete "$INSTDIR\snapraid.exe"
    Delete "$INSTDIR\snapraidd.exe"
    Delete "$INSTDIR\smartctl.exe"
    Delete "$INSTDIR\commander.zip"
    Delete "$INSTDIR\brutale.zip"
    Delete "$INSTDIR\snapraid.conf.example"
    Delete "$INSTDIR\snapraidd.conf.example"
    Delete "$INSTDIR\authors.txt"
    Delete "$INSTDIR\copying.txt"
    Delete "$INSTDIR\history.txt"
    Delete "$INSTDIR\readme.txt"
    Delete "$INSTDIR\doc\snapraid*.txt"

    RMDir "$INSTDIR\doc"
    RMDir "$INSTDIR"
SectionEnd
