#!/bin/bash
#
# Script to manually build a Debian .deb package for @PACKAGE_NAME@ on Slackware
# (using only dpkg-deb; no dpkg-buildpackage or debhelper needed)
#
# This avoids the /var/lib/dpkg/status issue entirely by:
# - Building the source directly
# - Installing into a temporary package root directory
# - Creating minimal DEBIAN/control manually
# - Packaging with dpkg-deb --root-owner-group
#

set -euo pipefail

CLI_VERSION="14.4"
CLI_TARBALL="snapraid-${CLI_VERSION}.tar.gz"
CLI_SOURCE_URL="https://github.com/amadvance/snapraid/releases/download/v${CLI_VERSION}/${CLI_TARBALL}"
CLI_PKG_NAME="snapraid"

DAEMON_VERSION="@PACKAGE_VERSION@"
DAEMON_TARBALL="@PACKAGE@-${DAEMON_VERSION}.tar.gz"
DAEMON_SOURCE_URL="https://github.com/amadvance/@PACKAGE@/releases/download/v${DAEMON_VERSION}/${DAEMON_TARBALL}"
DAEMON_PKG_NAME="@PACKAGE@"

NSIS_PKG_ROOT="@PACKAGE@-${DAEMON_VERSION}-nsis"

# Prefer local tarball
if [[ -f "./${CLI_TARBALL}" ]]; then
  echo "Using local ${CLI_TARBALL}"
else
  echo "Downloading ${CLI_TARBALL}..."
  curl -L -O "$CLI_SOURCE_URL"
fi

if [[ -f "./${DAEMON_TARBALL}" ]]; then
  echo "Using local ${DAEMON_TARBALL}"
else
  echo "Downloading ${DAEMON_TARBALL}..."
  curl -L -O "$DAEMON_SOURCE_URL"
fi

# Clean previous builds
rm -rf "${NSIS_PKG_ROOT}" 
rm -rf "${CLI_PKG_NAME}-${CLI_VERSION}"
rm -rf "${DAEMON_PKG_NAME}-${DAEMON_VERSION}"

# Create dirs
mkdir "${NSIS_PKG_ROOT}"

#### CLI ###

# Extract source
echo "Extracting ${CLI_PKG_NAME} source..."
tar -xzf "${CLI_TARBALL}"

# Build the software
echo "Configuring and building ${CLI_PKG_NAME}..."
cd ${CLI_PKG_NAME}-${CLI_VERSION}
./configure.windows-x64
make -j4

# Copy files
osslsigncode sign \
    -pkcs12 ../cert/am_code.p12 \
    -pass "" \
    -n "SnapRAID CLI" \
    -i "https://www.snapraid.it" \
    -ts "http://timestamp.digicert.com" \
    -in "snapraid.exe" \
    -out "../${NSIS_PKG_ROOT}/snapraid.exe"
cp doc/*.txt "../${NSIS_PKG_ROOT}"
todos < snapraid.conf.example > "../${NSIS_PKG_ROOT}/snapraid.conf.example"
todos < AUTHORS > "../${NSIS_PKG_ROOT}/authors.txt"
todos < HISTORY > "../${NSIS_PKG_ROOT}/history.txt"
todos < README > "../${NSIS_PKG_ROOT}/readme.txt"

cd ..

### DAEMON ###

# Extract source
echo "Extracting ${DAEMON_PKG_NAME} source..."
tar -xzf "${DAEMON_TARBALL}"

# Build the software
echo "Configuring and building ${DAEMON_PKG_NAME}..."
cd ${DAEMON_PKG_NAME}-${DAEMON_VERSION}
./configure.windows-x64
make -j4

# Copy files
osslsigncode sign \
    -pkcs12 ../cert/am_code.p12 \
    -pass "" \
    -n "SnapRAID Daemon" \
    -i "https://www.snapraid.it" \
    -ts "http://timestamp.digicert.com" \
    -in "snapraidd.exe" \
    -out "../${NSIS_PKG_ROOT}/snapraidd.exe"
cp commander.zip "../${NSIS_PKG_ROOT}"
cp doc/*.txt "../${NSIS_PKG_ROOT}"
cp pkg/snapraid-daemon.ico "../${NSIS_PKG_ROOT}"
cp pkg/snapraid-daemon.nsis "../${NSIS_PKG_ROOT}"
todos < snapraidd.conf.example > "../${NSIS_PKG_ROOT}/snapraidd.conf.example"
todos < snapraidd.yaml > "../${NSIS_PKG_ROOT}/snapraidd.yaml"
echo | todos >> "../${NSIS_PKG_ROOT}/history.txt"
todos < HISTORY >> "../${NSIS_PKG_ROOT}/history.txt"
echo | todos >> "../${NSIS_PKG_ROOT}/readme.txt"
todos < README >> "../${NSIS_PKG_ROOT}/readme.txt"
todos < LICENSES/GPL-3.0 > "../${NSIS_PKG_ROOT}/copying.txt"

cd ..

### NSIS ###

# Copy smartctl from current dir
osslsigncode sign \
    -pkcs12 cert/am_code.p12 \
    -pass "" \
    -n "SnapRAID SMARTCTL" \
    -i "https://www.snapraid.it" \
    -ts "http://timestamp.digicert.com" \
    -in "support/smartctl.exe" \
    -out "${NSIS_PKG_ROOT}/smartctl.exe"

cd ${NSIS_PKG_ROOT}

echo "Building NSIS installer..."
/usr/local/nsis/Bin/makensis snapraid-daemon.nsis

cd ..

# Sign and copy
rm -f "${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe"
osslsigncode sign \
    -pkcs12 cert/am_code.p12 \
    -pass "" \
    -n "SnapRAID Daemon Installer" \
    -i "https://www.snapraid.it" \
    -ts "http://timestamp.digicert.com" \
    -in "${NSIS_PKG_ROOT}/${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe" \
    -out "${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe"

osslsigncode verify -CAfile cert/am_ca.crt "${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe"

# Cleanup
rm -rf "${NSIS_PKG_ROOT}" 
rm -rf "${CLI_PKG_NAME}-${CLI_VERSION}"
rm -rf "${DAEMON_PKG_NAME}-${DAEMON_VERSION}"

echo ""
echo "Build complete!"
echo "Package created: ${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe"
echo ""
echo "SHAR256: " `sha256sum "${DAEMON_PKG_NAME}-${DAEMON_VERSION}.exe"`
